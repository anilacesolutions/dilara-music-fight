# Copy to .env.local and fill in. .env.local is gitignored.

# MongoDB connection string (Atlas or local)
MONGODB_URI=
MONGODB_DB=music_fight

# Which referee judges songs and reviews chat.
# "mock" = title-similarity stand-in, no LLM. "openai" or "bedrock" = a real model.
JUDGE_PROVIDER=mock

# --- Amazon Bedrock ---
# Nova Lite in Frankfurt is only served through the EU cross-region profile.
AWS_REGION=eu-central-1
BEDROCK_MODEL_ID=eu.amazon.nova-lite-v1:0
# A Bedrock API key. The AWS SDK reads this variable by itself.
AWS_BEARER_TOKEN_BEDROCK=

# Optional. With a key, song durations come from the official YouTube Data API.
# Without one they are read from the public watch page - fine for development.
YOUTUBE_API_KEY=

# Development only: shrink the 80% listening rule for testing, e.g. 0.05.
# Ignored by production builds.
# MF_LISTEN_RATIO=

# --- OpenAI referee ---
# Leave the model alone unless you have retested it. The mini model ruled all
# twelve trial cases correctly; the nano one rejected songs that clearly fit
# (grunge after grunge) and missed an English tip in chat, which would cost
# players points they earned and let a tip through.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# The absolute URL used in link previews. Falls back to the Amplify domain.
NEXT_PUBLIC_SITE_URL=
